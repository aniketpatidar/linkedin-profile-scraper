{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkedin-profile-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "secrets": {
    "required": ["LINKEDIN_SESSION_COOKIE"]
  }
}
